[node name="epilogue" type="CanvasLayer"]
script = ExtResource("1_4caow")
batch_1 = "[center]
You feel heavy...AGAIN
You tried to move your body but it wouldn't listen....
[/center]"
batch_2 = "[center]
Your eyes, they are filled with darkness...It's fine, you are getting used to it.

But wait...

You see something...it's faint but you see it.
No its just the fog...endless fog.
[/center]"
batch_3 = "[center]
That's it. That's all there is.

It's voice! You can't hear it's voice anymore..
You tried to call out

...

No response.
[/center]"
batch_4 = "[center]
You can't scream either, do you even have a mouth?

You stop fighting, You know you can't do anything without them...

You went back to sleep...
It's for the best.
[/center]"

